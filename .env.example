# Gemini (optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Admin CMS credentials (both required for login)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"
SESSION_SECRET="change-me-to-a-long-random-string"
PORT=8787
DATABASE_PATH="./server/data/cms.sqlite"

# Local font/keyboard/feedback file storage (relative to project or absolute path)
# Default: ./server/uploads  → served at /uploads/...
UPLOADS_DIR="./server/uploads"

# Feedback email notifications go to ADMIN_EMAIL (same as login email)
# Optional From address (defaults to SMTP_USER or ADMIN_EMAIL)
FEEDBACK_FROM_EMAIL="feedback@localhost"

# Local testing SMTP — Maildev (open source, free)
# Start with: npm run mail   (or npm run dev:all)
# Inbox UI: http://localhost:1080
# For production, replace with your real SMTP provider.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
